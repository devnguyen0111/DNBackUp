{
  "schemaVersion": 1,
  "id": "dnbackup",
  "version": "${version}",
  "name": "DNBackUp",
  "description": "A premium Fabric mod to automatically and manually back up your Minecraft worlds, featuring async compression, storage size/count limits, and a beautiful HUD progress tracker.",
  "authors": [
    "devnguyen0111"
  ],
  "contact": {
    "homepage": "https://github.com/devnguyen0111/DNBackUp",
    "sources": "https://github.com/devnguyen0111/DNBackUp",
    "issues": "https://github.com/devnguyen0111/DNBackUp/issues"
  },
  "license": "BSD-2-Clause-FreeBSD",
  "icon": "assets/dnbackup/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "org.dnplugins.dnbackup.Dnbackup"
    ],
    "client": [
      "org.dnplugins.dnbackup.client.DnbackupClient"
    ]
  },

  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=25"
  }
}
